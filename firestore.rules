rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "PUT_ADMIN_EMAIL_HERE";
    }

    match /egg_store/main {
      allow read, write: if isAdmin();
    }

    match /store_public/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /online_orders/{orderId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous"
        && request.resource.data.keys().hasOnly([
          "name", "phone", "address", "type", "typeName", "trays",
          "unitPrice", "total", "status", "timestamp", "date"
        ])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.type in ["large", "medium", "small", "red_large", "white_large", "bashayer"]
        && request.resource.data.trays is int
        && request.resource.data.trays >= 1
        && request.resource.data.unitPrice is number
        && request.resource.data.total is number
        && request.resource.data.status == "pending";

      allow read, update, delete: if isAdmin();
    }
  }
}
